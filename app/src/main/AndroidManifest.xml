<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Kafelki mapy i styl pobierane z sieci -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Dokładna lokalizacja jest potrzebna do zaliczenia szczytu (promień 150 m) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Zdjęcie ze szczytu z podglądem na żywo w aplikacji -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Powiadomienia push o znajomych (Android 13+ pyta o zgodę) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Szczytomania">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Wiadomości FCM od Cloud Functions (firebase/functions) -->
        <service
            android:name=".notifications.SzczytomaniaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
