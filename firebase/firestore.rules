rules_version = '2';

// Reguły bezpieczeństwa Cloud Firestore. Źródłem prawdy jest ten plik –
// po zmianie wklej go w konsoli Firebase: Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Profil użytkownika: dokument users/{uid}.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function validNick() {
        return request.resource.data.nick is string
          && request.resource.data.nick.size() >= 3
          && request.resource.data.nick.size() <= 20;
      }

      // Nick i zdjęcie widzi każdy zalogowany (potrzebne do wyszukiwania znajomych).
      allow read: if request.auth != null;

      // Profil zakłada tylko właściciel, z czasem serwera i bez dodatkowych pól.
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['nick', 'photoUrl', 'createdAt'])
        && validNick()
        && request.resource.data.createdAt == request.time;

      // Właściciel może zmienić nick i zdjęcie, ale nie datę założenia konta.
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nick', 'photoUrl'])
        && validNick();

      // Usuwanie konta zrobimy w tygodniu 7 (razem z danymi i zdjęciami).
      allow delete: if false;

      // Zdobycze użytkownika: users/{uid}/conquests/{conquestId}, jeden dokument na szczyt.
      match /conquests/{conquestId} {
        function conquestFields() {
          return ['peakId', 'conqueredAt', 'serverTime', 'lat', 'lon', 'accuracy', 'photoUrl', 'photoStatus'];
        }

        // Na razie widzi je tylko właściciel – znajomym otworzymy je w tygodniu 5.
        allow read: if isOwner();

        // Id dokumentu to id szczytu z "_" zamiast "/" (np. node_4366169405), więc ten sam szczyt
        // zapisze się tylko raz. Czas serwera ustawia serwer, a zdjęcie na start czeka na wysłanie.
        allow create: if isOwner()
          && request.resource.data.keys().hasAll(conquestFields())
          && request.resource.data.keys().hasOnly(conquestFields())
          && request.resource.data.peakId is string
          && conquestId == request.resource.data.peakId.replace('/', '_')
          && request.resource.data.conqueredAt is timestamp
          && request.resource.data.serverTime == request.time
          && request.resource.data.lat is number
          && request.resource.data.lon is number
          && request.resource.data.accuracy is number
          && request.resource.data.photoUrl == null
          && request.resource.data.photoStatus == 'pending';

        // Zmianę statusu zdjęcia na "wysłane" dodamy w tygodniu 4, usuwanie – razem z kontem w tygodniu 7.
        allow update, delete: if false;
      }
    }

    // Wszystko inne pozostaje zablokowane, dopóki nie dopiszemy reguł.
  }
}
