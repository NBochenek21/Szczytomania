rules_version = '2';

// Reguły bezpieczeństwa Cloud Firestore. Źródłem prawdy jest ten plik –
// po zmianie wklej go w konsoli Firebase: Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Id znajomości dwóch osób: ich uid posortowane i połączone "_" – ta sama para ma zawsze
    // ten sam dokument, więc nie da się wysłać dwóch zaproszeń. Aplikacja liczy je tak samo
    // (FriendRepository.pairId).
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function friendshipPath(a, b) {
      return /databases/$(database)/documents/friendships/$(pairId(a, b));
    }

    // Profil użytkownika: dokument users/{uid}.
    match /users/{uid} {
      function isOwner() {
        return signedIn() && request.auth.uid == uid;
      }

      // Nick: 3–20 znaków – litery bez polskich znaków, cyfry, kropka, podkreślenie, myślnik
      // (lower() w regułach nie zmienia wielkości polskich liter, a nick jest też id dokumentu w nicks).
      // nickLower to nick małymi literami – po nim działa wyszukiwanie znajomych. Nick musi być
      // zarezerwowany w nicks dla tego użytkownika w tym samym zapisie, więc dwie osoby nie mogą
      // mieć tego samego nicku.
      function validNick() {
        let nick = request.resource.data.nick;
        return nick is string
          && nick.matches('[A-Za-z0-9._-]{3,20}')
          && request.resource.data.nickLower == nick.lower()
          && getAfter(/databases/$(database)/documents/nicks/$(nick.lower())).data.uid == uid;
      }

      // Zdobycze może zobaczyć znajomy (zaproszenie zaakceptowane) i osoba, którą właściciel
      // zaprosił – żeby przy zaproszeniu widziała, ile ma szczytów.
      function canSeeConquests() {
        let friendship = get(friendshipPath(request.auth.uid, uid)).data;
        return friendship.status == 'accepted' || friendship.from == uid;
      }

      // Nick i zdjęcie widzi każdy zalogowany (potrzebne do wyszukiwania znajomych).
      allow read: if signedIn();

      // Profil zakłada tylko właściciel, z czasem serwera i bez dodatkowych pól.
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['nick', 'nickLower', 'photoUrl', 'createdAt'])
        && validNick()
        && request.resource.data.createdAt == request.time;

      // Właściciel może zmienić nick i zdjęcie, ale nie datę założenia konta.
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nick', 'nickLower', 'photoUrl'])
        && validNick();

      // Usuwanie konta zrobimy w tygodniu 7 (razem z danymi i zdjęciami).
      allow delete: if false;

      // Telefony do powiadomień push: users/{uid}/devices/{token FCM}. Widzi i zmienia je tylko
      // właściciel – profil czyta każdy zalogowany, więc tokeny nie mogą być w nim. Powiadomienia
      // wysyła Cloud Function (firebase/functions), która ma dostęp administratora.
      match /devices/{token} {
        allow read, delete: if isOwner();
        allow create, update: if isOwner()
          && token.size() <= 500
          && request.resource.data.keys().hasOnly(['updatedAt'])
          && request.resource.data.updatedAt == request.time;
      }

      // Zdobycze użytkownika: users/{uid}/conquests/{conquestId}, jeden dokument na szczyt.
      match /conquests/{conquestId} {
        function conquestFields() {
          return ['peakId', 'conqueredAt', 'serverTime', 'lat', 'lon', 'accuracy', 'photoUrl', 'photoStatus'];
        }

        allow read: if isOwner() || canSeeConquests();

        // Id dokumentu to id szczytu z "_" zamiast "/" (np. node_4366169405), więc ten sam szczyt
        // zapisze się tylko raz. Czas serwera ustawia serwer, a zdjęcie na start czeka na wysłanie.
        allow create: if isOwner()
          && request.resource.data.keys().hasAll(conquestFields())
          && request.resource.data.keys().hasOnly(conquestFields())
          && request.resource.data.peakId is string
          && conquestId == request.resource.data.peakId.replace('/', '_')
          && request.resource.data.conqueredAt is timestamp
          && request.resource.data.serverTime == request.time
          && request.resource.data.lat is number
          && request.resource.data.lon is number
          && request.resource.data.accuracy is number
          && request.resource.data.photoUrl == null
          && request.resource.data.photoStatus == 'pending';

        // Po wysłaniu zdjęcia zmieniają się tylko link i status: z "pending" na "uploaded".
        // Szczyt, czas i współrzędne zostają takie jak przy zdobyciu.
        allow update: if isOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoUrl', 'photoStatus'])
          && resource.data.photoStatus == 'pending'
          && request.resource.data.photoStatus == 'uploaded'
          && request.resource.data.photoUrl is string;

        // Usuwanie zdobyczy – razem z kontem w tygodniu 7.
        allow delete: if false;
      }
    }

    // Zajęte nicki: nicks/{nick małymi literami} → uid właściciela. Dokument może powstać tylko raz,
    // więc nick ma jedna osoba. Rezerwacja idzie w jednym zapisie z profilem (patrz validNick).
    match /nicks/{nick} {
      // Rejestracja sprawdza, czy nick jest wolny, zanim powstanie konto – więc odczyt jednego nicku
      // jest dostępny też bez logowania. Listy wszystkich nicków pobrać się nie da.
      allow get: if true;
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.nickLower == nick;

      // Stary nick zwalnia się przy zmianie nicku – tylko właściciel i tylko gdy profil ma już inny.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.nickLower != nick;

      allow update: if false;
    }

    // Znajomości: friendships/{uid1_uid2} – dwie osoby i status (zaproszenie / zaakceptowane).
    match /friendships/{friendshipId} {
      // Widzą ją tylko te dwie osoby (aplikacja pyta o nie zapytaniem "users array-contains uid").
      allow read: if signedIn() && request.auth.uid in resource.data.users;

      // Zaproszenie wysyła się tylko we własnym imieniu, do istniejącego użytkownika, nie do siebie.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['users', 'from', 'to', 'status', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && friendshipId == pairId(request.auth.uid, request.resource.data.to)
        && request.resource.data.users.size() == 2
        && request.resource.data.users.hasAll([request.auth.uid, request.resource.data.to])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.resource.data.to));

      // Zaakceptować może tylko zaproszony – zmienia się tylko status i dochodzi czas akceptacji.
      allow update: if signedIn()
        && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedAt == request.time;

      // Odrzucenie, anulowanie zaproszenia albo usunięcie ze znajomych – każda z dwóch osób.
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // Własne zestawy gór: sets/{setId}. Widzi je właściciel i osoby z listy sharedWith
    // (znajomi, którym właściciel udostępnił zestaw – najwyżej 20 osób).
    match /sets/{setId} {
      allow read: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.sharedWith);

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'peakIds', 'sharedWith', 'createdAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.peakIds is list
        && request.resource.data.peakIds.size() >= 1
        && request.resource.data.peakIds.size() <= 300
        && request.resource.data.sharedWith is list
        && request.resource.data.sharedWith.size() <= 20
        && !(request.auth.uid in request.resource.data.sharedWith)
        && request.resource.data.createdAt == request.time;

      // Właściciel może zmienić tylko listę osób, którym udostępnił zestaw. Usunąć może tylko właściciel.
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedWith'])
        && request.resource.data.sharedWith is list
        && request.resource.data.sharedWith.size() <= 20
        && !(request.auth.uid in request.resource.data.sharedWith);
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Wyzwania (wyścigi) ze znajomymi: challenges/{id}. Widzą je tylko uczestnicy.
    // Każdy uczestnik zapisuje tylko swój wynik w scores.{uid} – liczy go jego telefon ze zdobyczy.
    match /challenges/{challengeId} {
      function participant() {
        return signedIn() && request.auth.uid in resource.data.participants;
      }

      allow read: if participant();

      // Zakłada właściciel: zestaw (nazwa + szczyty), tryb, 2–10 uczestników (z nim samym),
      // data końca tylko w wyścigu "kto więcej do daty" i zawsze w przyszłości, na start bez wyników.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerId', 'setName', 'peakIds', 'mode', 'participants', 'createdAt', 'endsAt', 'scores'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.setName is string
        && request.resource.data.setName.size() >= 1
        && request.resource.data.setName.size() <= 60
        && request.resource.data.peakIds is list
        && request.resource.data.peakIds.size() >= 1
        && request.resource.data.peakIds.size() <= 300
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 10
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.createdAt == request.time
        && request.resource.data.scores == {}
        && ((request.resource.data.mode == 'first' && request.resource.data.endsAt == null)
          || (request.resource.data.mode == 'most' && request.resource.data.endsAt is timestamp
            && request.resource.data.endsAt > request.time));

      // Uczestnik zmienia tylko własny wynik: liczba zdobytych szczytów zestawu i czas ukończenia.
      allow update: if participant()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scores'])
        && request.resource.data.scores.diff(resource.data.scores).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.scores[request.auth.uid].keys().hasOnly(['done', 'completedAt'])
        && request.resource.data.scores[request.auth.uid].done is int
        && request.resource.data.scores[request.auth.uid].done >= 0
        && request.resource.data.scores[request.auth.uid].done <= resource.data.peakIds.size();

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Wszystko inne pozostaje zablokowane, dopóki nie dopiszemy reguł.
  }
}
